---
import Base from '@/layouts/Base.astro'
import PostInfo from '@/components/PostInfo.astro'

const { frontmatter } = Astro.props
---

<Base meta={{ title: frontmatter.title }}>
  <div class="blog-wrap">
    <div
      id="markdown"
      class="prose prose-lightMode dark:prose-darkMode prose-code:bg-main prose-headings:font-heading prose-headings:text-foreground prose-a:text-foreground prose-blockquote:text-foreground prose-strong:text-foreground prose-ol:text-foreground prose-ul:text-foreground prose-table:text-foreground prose-tr:text-foreground prose-td:text-foreground text-foreground w-full min-w-full leading-loose"
    >
      <PostInfo
        title={frontmatter.title}
        date={frontmatter.pubDate}
        tags={frontmatter.tags}
      />
      <slot />
    </div>
  </div>
</Base>

<style>
  .blog-wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 120px 32px 100px;
  }

  @media (max-width: 768px) {
    .blog-wrap { padding: 100px 20px 80px; }
  }
</style>

<style is:global>
  #markdown code:not(pre)::before,
  #markdown code:not(pre)::after {
    content: '';
  }

  html #markdown code:not(pre code) {
    border: 1px solid var(--border);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'Space Mono', monospace;
    font-size: 0.875em;
  }
</style>
