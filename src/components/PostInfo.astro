---
const { title, date, tags } = Astro.props
---

<div class="post-info not-prose">
  <h1 class="post-title">{title}</h1>
  <div class="post-meta">
    <div class="post-date">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="-0.5 0 15 15"
        style="flex-shrink: 0;"
      >
        <path
          fill="currentColor"
          fill-rule="evenodd"
          d="M61,154.006845 C61,153.45078 61.4499488,153 62.0068455,153 L73.9931545,153 C74.5492199,153 75,153.449949 75,154.006845 L75,165.993155 C75,166.54922 74.5500512,167 73.9931545,167 L62.0068455,167 C61.4507801,167 61,166.550051 61,165.993155 L61,154.006845 Z M62,157 L74,157 L74,166 L62,166 L62,157 Z M64,152.5 C64,152.223858 64.214035,152 64.5046844,152 L65.4953156,152 C65.7740451,152 66,152.231934 66,152.5 L66,153 L64,153 L64,152.5 Z M70,152.5 C70,152.223858 70.214035,152 70.5046844,152 L71.4953156,152 C71.7740451,152 72,152.231934 72,152.5 L72,153 L70,153 L70,152.5 Z"
          transform="translate(-61 -152)"></path>
      </svg>
      {date}
    </div>
    <div class="post-tags">
      {
        tags.map((tag: string) => (
          <a href={`/tags/${tag}`} class="post-tag">
            #{tag}
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .post-info {
    margin-bottom: 40px;
    padding-bottom: 32px;
    border-bottom: 2px solid var(--border);
  }

  .post-title {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 16px;
    line-height: 1.1;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .post-date {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    color: var(--text3);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .post-tag {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    border: 2px solid var(--accent);
    padding: 3px 8px;
    text-decoration: none;
    transition: all 0.12s ease;
  }

  .post-tag:hover {
    background: var(--accent);
    color: #fff;
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-sm);
  }
</style>
