---
// @ts-nocheck
import config from '@/config'
import { getCollection } from 'astro:content'

import Base from '@/layouts/Base.astro'
import PostPreview from '@/components/PostPreview.astro'

const allPosts = await getCollection('posts')
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
)
---

<Base meta={{ title: 'Blog — Lilitha Mdlalana' }}>
  <div class="page-wrap">
    <div class="section-inner">
      <div class="page-header fade-in">
        <div class="header-left">
          <span class="section-label">Blog</span>
          <h1 class="page-title">Writing</h1>
        </div>
        <div class="view-toggle" id="viewToggle">
          <button class="toggle-btn active" id="btnGrid" aria-label="Grid view">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <rect x="0" y="0" width="7" height="7" fill="currentColor"/>
              <rect x="9" y="0" width="7" height="7" fill="currentColor"/>
              <rect x="0" y="9" width="7" height="7" fill="currentColor"/>
              <rect x="9" y="9" width="7" height="7" fill="currentColor"/>
            </svg>
          </button>
          <button class="toggle-btn" id="btnList" aria-label="List view">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <rect x="0" y="1" width="16" height="2.5" fill="currentColor"/>
              <rect x="0" y="6.5" width="16" height="2.5" fill="currentColor"/>
              <rect x="0" y="12" width="16" height="2.5" fill="currentColor"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="posts-grid" id="postsContainer">
        {
          sortedPosts.map((post) => (
            <PostPreview
              url={`/blog/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
            />
          ))
        }
      </div>
    </div>
  </div>
</Base>

<script is:inline>
  function setupViewToggle() {
    const btnGrid = document.getElementById('btnGrid')
    const btnList = document.getElementById('btnList')
    const container = document.getElementById('postsContainer')
    if (!btnGrid || !btnList || !container) return

    const saved = localStorage.getItem('blogView') || 'grid'
    if (saved === 'list') {
      container.classList.add('list-view')
      btnList.classList.add('active')
      btnGrid.classList.remove('active')
    }

    btnGrid.addEventListener('click', () => {
      container.classList.remove('list-view')
      btnGrid.classList.add('active')
      btnList.classList.remove('active')
      localStorage.setItem('blogView', 'grid')
    })

    btnList.addEventListener('click', () => {
      container.classList.add('list-view')
      btnList.classList.add('active')
      btnGrid.classList.remove('active')
      localStorage.setItem('blogView', 'list')
    });
  }

  setupViewToggle()
  document.addEventListener('astro:after-swap', setupViewToggle)
</script>

<style>
  .page-wrap { padding: 120px 0 100px; }

  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 48px;
    border-bottom: 2px solid var(--border);
    padding-bottom: 20px;
  }

  .header-left {
    display: flex;
    align-items: baseline;
    gap: 20px;
  }

  .section-label {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    border: 2px solid var(--accent);
    padding: 4px 10px;
    box-shadow: 2px 2px 0 var(--accent);
    white-space: nowrap;
  }

  .page-title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  /* VIEW TOGGLE */
  .view-toggle {
    display: flex;
    gap: 0;
    border: 2px solid var(--border);
    box-shadow: var(--shadow-sm);
  }

  .toggle-btn {
    background: var(--surface);
    border: none;
    padding: 8px 12px;
    cursor: pointer;
    color: var(--text3);
    display: flex;
    align-items: center;
    transition: all 0.12s ease;
  }

  .toggle-btn:first-child {
    border-right: 2px solid var(--border);
  }

  .toggle-btn.active {
    background: var(--text);
    color: var(--bg);
  }

  .toggle-btn:not(.active):hover {
    background: var(--surface2);
    color: var(--text);
  }

  /* GRID VIEW (default) */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0;
    transition: all 0.2s ease;
  }

  /* LIST VIEW */
  .posts-grid.list-view {
    grid-template-columns: 1fr;
  }

  .posts-grid.list-view :global(.post-card) {
    flex-direction: row;
    align-items: center;
    gap: 24px;
  }

  .posts-grid.list-view :global(.post-title) {
    font-size: 16px;
    flex: 1;
    min-width: 0;
  }

  .posts-grid.list-view :global(.post-desc) {
    display: none;
  }

  .posts-grid.list-view :global(.post-date) {
    margin-top: 0;
    flex-shrink: 0;
    font-size: 11px;
  }

  @media (max-width: 768px) {
    .page-wrap { padding: 100px 0 80px; }
    .posts-grid { grid-template-columns: 1fr; }
    .posts-grid.list-view :global(.post-card) { flex-direction: column; }
    .posts-grid.list-view :global(.post-desc) { display: block; }
  }
</style>
