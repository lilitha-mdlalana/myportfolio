---
import Base from '@/layouts/Base.astro'
---

<Base meta={{ title: '404 — Page Not Found' }}>
  <div class="not-found">
    <p class="eyebrow">404</p>
    <h1>Page Not Found</h1>
    <p class="desc">This page doesn't exist. Let's get you back on track.</p>
    <a href="/" class="btn btn-primary">← Go Home</a>
  </div>
</Base>

<style>
  .not-found {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 120px 32px;
    max-width: 1100px;
    margin: 0 auto;
    gap: 20px;
  }

  .eyebrow {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
  }

  h1 {
    font-size: clamp(36px, 6vw, 72px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--text);
  }

  .desc {
    font-size: 16px;
    color: var(--text2);
    max-width: 400px;
  }

  @media (max-width: 768px) {
    .not-found { padding: 100px 20px; }
  }
</style>
