---
import Base from '@/layouts/Base.astro'
import { labs } from '@/lib/projects'
---

<Base meta={{ title: 'Labs — Lilitha Mdlalana' }}>
  <div class="page-wrap">
    <div class="section-inner">
      <div class="page-header fade-in">
        <span class="section-label">Labs</span>
        <h1 class="page-title">Experiments</h1>
      </div>
      <p class="page-desc fade-in">
        Where I play. Each lab is a tiny experiment, a proof of concept, or a
        curiosity I wanted to explore. Some are polished, others are half-baked
        — all are learning in motion.
      </p>

      <div class="projects-grid">
        {
          labs.map((lab, i) => (
            <a
              href={lab.href}
              target={lab.href.startsWith('http') ? '_blank' : undefined}
              class="project-card fade-in"
            >
              <span class="project-num">
                {String(i + 1).padStart(2, '0')}
              </span>
              {lab.builtWith && (
                <p class="project-stack">{lab.builtWith.join(' · ')}</p>
              )}
              <h2 class="project-title">{lab.title}</h2>
              <p class="project-desc">{lab.description}</p>
              {lab.tags && (
                <div class="project-tags">
                  {lab.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Base>

<style>
  .page-wrap {
    padding: 120px 0 100px;
  }

  .page-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 24px;
    border-bottom: 2px solid var(--border);
    padding-bottom: 20px;
  }

  .section-label {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    border: 2px solid var(--accent);
    padding: 4px 10px;
    box-shadow: 2px 2px 0 var(--accent);
    white-space: nowrap;
  }

  .page-title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .page-desc {
    font-size: 16px;
    color: var(--text2);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 48px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 0;
  }

  .project-card {
    border: 2px solid var(--border);
    padding: 36px;
    background: var(--surface);
    margin: -1px;
    position: relative;
    transition: all 0.15s ease;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
    color: inherit;
  }

  .project-card:hover {
    z-index: 1;
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent);
  }

  .project-card:hover .project-title {
    color: var(--accent);
  }

  .project-card:hover .project-stack {
    color: var(--accent);
  }

  .project-card:hover .project-num {
    color: var(--accent);
    opacity: 0.3;
  }

  .project-num {
    font-family: 'Space Mono', monospace;
    font-size: 48px;
    font-weight: 700;
    color: var(--surface2);
    line-height: 1;
    position: absolute;
    top: 20px;
    right: 28px;
    transition: color 0.15s ease;
  }

  .project-stack {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    color: var(--accent2);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-top: 16px;
  }

  .project-title {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    transition: color 0.15s ease;
  }

  .project-desc {
    font-size: 14px;
    color: var(--text2);
    line-height: 1.7;
    flex: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }

  @media (max-width: 768px) {
    .page-wrap { padding: 100px 0 80px; }
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
